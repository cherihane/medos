# Supabase
# REACT_APP_* : publiques par conception (inlinees dans le bundle frontend par
# Create React App) — jamais un secret a proteger, contrairement aux deux
# variables service_role ci-dessous.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Cle service_role (acces admin complet, bypass RLS) — SECRET, ne jamais
# commiter, ne jamais utiliser dans un fichier REACT_APP_*. Utilisee par
# scripts/create-test-users.js, scripts/create-staff-users.js et l'Edge
# Function invite-membre.
SUPABASE_SERVICE_KEY=

# Meme cle service_role, nom attendu par scripts/deploy-with-token.sh et par
# le runtime des Edge Functions (SUPABASE_SERVICE_ROLE_KEY). Renseigner la
# meme valeur que SUPABASE_SERVICE_KEY ci-dessus.
SUPABASE_SERVICE_ROLE_KEY=

# Webhook interne (verification des appels vers certaines Edge Functions)
WEBHOOK_SECRET=

# Groq (previsions IA)
REACT_APP_GROQ_API_KEY=

# Resend (emails transactionnels — envoyes uniquement depuis les Edge
# Functions cote serveur, jamais depuis le frontend : ne JAMAIS utiliser de
# variable REACT_APP_RESEND_KEY, ca l'exposerait dans le bundle client)
RESEND_API_KEY=
